{
  "name": "@tcons/atmos",
  "version": "0.0.0",
  "description": "Atmos bridge for @tcons/component: source cdktn component configuration from `atmos describe component`",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerraConstructs/component-kit.git",
    "directory": "packages/atmos"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./aws": {
      "types": "./dist/aws/index.d.ts",
      "default": "./dist/aws/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "aws": [
        "dist/aws/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/**",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.dev.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo coverage"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@tcons/component": "workspace:^"
  },
  "peerDependencies": {
    "@cdktn/provider-aws": "^26.0.0",
    "@cdktn/provider-cloudflare": "^17.0.0",
    "@cdktn/provider-datadog": "^17.0.0",
    "cdktn": "^0.25.1",
    "constructs": "^10.7.2",
    "terraconstructs": "^0.2.21",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@cdktn/provider-cloudflare": {
      "optional": true
    },
    "@cdktn/provider-datadog": {
      "optional": true
    },
    "terraconstructs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-cdk/cloud-assembly-schema": "^54.17.0",
    "@aws-cdk/region-info": "^2.233.0",
    "@cdktn/provider-archive": "^15.0.0",
    "@cdktn/provider-aws": "26.0.1",
    "@cdktn/provider-cloudflare": "^17.0.1",
    "@cdktn/provider-cloudinit": "^15.0.0",
    "@cdktn/provider-datadog": "^17.0.0",
    "@cdktn/provider-docker": "^17.0.0",
    "@cdktn/provider-time": "^15.0.0",
    "@cdktn/provider-tls": "^15.0.0",
    "@cdktn/vitest": "0.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@vincenthsh/cdktf-fogg-helpers": "5.0.0",
    "cdktn": "0.25.1",
    "constructs": "10.8.1",
    "js-yaml": "^4.3.2",
    "terraconstructs": "0.2.21",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
