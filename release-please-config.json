{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "initial-version": "0.1.0",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Bug Fixes",
      "hidden": false
    },
    {
      "type": "chore",
      "section": "Misc",
      "hidden": false
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": false
    }
  ],
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "separate-pull-requests": false,
  "packages": {
    "packages/component": {
      "component": "component"
    },
    "packages/atmos": {
      "component": "atmos"
    }
  },
  "plugins": [
    {
      "type": "node-workspace"
    }
  ]
}
